#include <Stepper.h>
// Tentukan jumlah langkah per putaran untuk motor stepper (biasanya 2048 untuk motor stepper biasa)
#define STEPS_PER_REVOLUTION 2048  

int irpin1 = 6; //ir kanan
int irpin2 = 7; //ir kiri
int irpin3 = 12;

int irstate1;
int irstate2;
int irstate3;

int mode = 0;
int gerak = 0;

long wlserial = 0;
long wlputar1 = 0;
long wlputar2 = 0;

//in1 in3 in2 in4
Stepper stepper1(STEPS_PER_REVOLUTION, 2, 4, 3, 5);  //Roda kanan
Stepper stepper2(STEPS_PER_REVOLUTION, 8, 10, 9, 11); // Roda kiri

void setup() {
  Serial.begin(9600);

  pinMode(irpin1, INPUT);
  pinMode(irpin2, INPUT);
  pinMode(irpin3, INPUT);
  // Set kecepatan motor dalam RPM (putaran per menit)
  stepper1.setSpeed(14); 
  stepper2.setSpeed(14);  
}

void loop() {
  long wserial = millis();
  if (wserial - wlserial >= 1000) {
    Serial.print(mode);
    Serial.print(" ");
    Serial.println(gerak);

    wlserial = wserial;
  }
  irstate1 = digitalRead(irpin1);
  irstate2 = digitalRead(irpin2);
  irstate3 = digitalRead(irpin3);

  // robot bergerak ketika sensor ir3 mendeteksi benda, bergerak umpama line follower, saat sensor ir1 dan ir2 mendeteksi garis hitam, robot berhenti
  // LOW lampu ir hidup kena garis putih, HIGH=ir mati=garis hitam
  // uji coba sebelum menggunakan jalur hitam, iratate1 dan irstate2 menggunakan logika LOW agar bisa memberi imput dengan suatu objek
  // saat menggunakan jalur hitam, logika LOW pada irstate1 dan irstate2 diganti ke HIGH
  if (mode == 0) {
    wlputar1 = 0;
    wlputar2 = 0;
    if (irstate3 == LOW) {
      if (irstate1 == LOW && irstate2 == LOW) {
        gerak = 0;
        mode = 1;
      } else if (irstate2 == LOW) {
        gerak = 2;
      } else if (irstate1 == LOW ) {
        gerak = 3;
      } else {
        gerak = 1;
      }
    } else {
      gerak = 0;
    }
  }

  // saat barang diambil, robot bergerak memutar selama 5 detik, mencari jalur sebelumnya
  if (mode == 1) {
    if (irstate3 == HIGH) {
      gerak = 3;
      
      // Set wputar1 hanya saat pertama kali memasuki mode 1
      if (wlputar1 == 0) {
        wlputar1 = millis();  // Set waktu saat pertama kali memasuki mode 1
      }

      if (millis() - wlputar1 >= 8000) {  // Tunggu selama 5 detik, robot berputar selama 5 detik
        mode = 2;  // Pindah ke mode 2
        gerak = 0;  // Set gerak ke 0
      }
    }
  }

  // robot bergerak kembali menyusuri jalur pulang dengan bergerak umpama line follower dan akan berhenti sambil berubah ke mode 3 saat ir1 dan ir2 mengenai garis hitam
  if (mode == 2) {
    if (irstate1 == LOW && irstate2 == LOW) {
      gerak = 0;
      mode = 3;
    } else if (irstate2 == LOW) {
      gerak = 2;
    } else if (irstate1 == LOW ) {
      gerak = 3;
    } else {
      gerak = 1;
    }
  }

  // robot berputar, kembali ke mode 0 untuk menerima barang
  if (mode == 3) {
    gerak = 3; 
    if (wlputar2 == 0) {
      wlputar2 = millis();
    }

    if (millis() - wlputar2 >= 8000) {
      mode = 0;
      gerak = 0;
    }
  }


  // if (mode == 1) {
  //   if (irstate3 == HIGH) {
  //     gerak = 3;
  //     if (gerak == 3) {
  //       long wputar1 = millis();
  //       if (wputar1 - wlputar1 >= 1000) {
  //         mode = 2;
  //         gerak = 0;
  //         wlputar1 = wputar1;
  //       }
  //     }
  //     // if (wlputar1 - wputar1 >= 3000) {
  //     //   mode = 2;
  //     //   wlputar1 = wputar1;
  //     // }
  //   }
  // }

  if (gerak == 0) {
    berhenti();
  }
  if (gerak == 1) {
    maju();
  }
  if (gerak == 2) {
    belokkiri();
  }
  if (gerak == 3) {
    belokkanan();
  }
  if (gerak == 4) {
    mundur();
  }
  
//   if (irstate3 == LOW) {
//       if (irstate1 == LOW && irstate2 == LOW) {
//         berhenti();
//       } else if (irstate2 == LOW) {
//         belokkiri();
//       } else if (irstate1 == LOW ) {
//         belokkanan();
//       } else {
//         maju();
//       }
//   } else {
//     berhenti();
//   }
}

void belokkiri() {
  stepper1.step(1);
  stepper2.step(1);
}

void belokkanan() {
  stepper1.step(-1);
  stepper2.step(-1);
}

void mundur() {
  stepper1.step(-1);
  stepper2.step(1);
}

void maju() {
  stepper1.step(1);
  stepper2.step(-1);
}

void berhenti() {
  stepper1.step(0);
  stepper2.step(0);
}
